{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fourier-atlas",
  "account_id": "ef7863c4de93e71c3496f940c8ab4865",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "xiaosang.cc/fourier-atlas",
      "zone_id": "a9ae8ed6c9a473e6c79daa58b29e8b12"
    },
    {
      "pattern": "xiaosang.cc/fourier-atlas/*",
      "zone_id": "a9ae8ed6c9a473e6c79daa58b29e8b12"
    }
  ],
  "main": "worker.js"
}
